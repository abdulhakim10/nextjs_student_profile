# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit any .env* (.env, .env.development, .env.production,
# .env.local, etc.). NEXT_PUBLIC_* values come from GitLab CI variables →
# --build-arg; local copies of .env* stay on disk for `npm run dev` and
# `npm run build` testing but never ship to git.
.env*
# Exception: .env.example IS committed — it's the documentation template that
# tells anyone forking base_view which NEXT_PUBLIC_* vars need to be wired up.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# windows
bash.exe.stackdump
