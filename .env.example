# Template — this is the ONLY env file committed to git. Every `.env*` file
# is gitignored; copy values from here into the local files below as needed:
#
#   .env              shared defaults loaded in every mode (dev + prod build)
#   .env.development  dev URL overrides, loaded by `npm run dev`
#   .env.production   prod URL overrides, loaded by local `npm run build`
#   .env.local        personal secrets (Anthropic, Maps key, etc.) — highest
#                     local priority, overrides the three above
#
# Production values for the DEPLOYED image do NOT come from any .env* file.
# They come from GitLab CI variables piped in via `--build-arg` (see the
# .gitlab-ci.yml `build` stage and the matching `ARG`/`ENV` pairs in
# Dockerfile). Keep that wiring in sync when you add a new NEXT_PUBLIC_* var.

# Backend API URLs
#
# NEXT_PUBLIC_API_BASE_URL is the root every per-service URL cascades to
# (see `src/config/api.ts`). In prod set only the root; in dev set per-
# service vars to point at the matching local backend host/port.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_API_BASE_URL=
NEXT_PUBLIC_UTILITIES_API_BASE_URL=
# Support help-desk guest create URL — where the "Contact support" button sends
# the user. Their info is appended as query params and the create page pre-fills
# the form (e.g. https://support-system-eight.vercel.app/help-desk/create).
NEXT_PUBLIC_SUPPORT_HELPDESK_URL=
# Support ticket-list URL — where the "My tickets" button sends the user. Opened
# as ?public=1&email=<email>; shows only that customer's tickets, chrome hidden
# (e.g. https://support-system-eight.vercel.app/tickets).
NEXT_PUBLIC_SUPPORT_TICKETS_URL=

# App config
NEXT_PUBLIC_API_VERSION=v2
NEXT_PUBLIC_DEFAULT_APP=eboss
NEXT_PUBLIC_DEFAULT_USER_TYPE=staff
NEXT_PUBLIC_APP_NAME=Admin Dashboard

# App version — bump on each release. Shown in header pill + /settings About.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_VERSION_DATE=2026-05-29

# Internal-team setup appcode — parity with salary_view's /internal/* gate.
# No internal area in this frontend yet, so currently unused here; wired so
# adding one later needs no CI/Docker/env change.
NEXT_PUBLIC_INTERNAL_APPCODE=awfatech

# AI Chat (Anthropic Claude) — server-side only, never exposed to browser.
# In prod this comes from AWS Secrets Manager via the ECS task def, not
# from --build-arg.
ANTHROPIC_API_KEY=
