# Template for local dev. Copy to `.env.development` (or `.env.local` for
# overrides) and fill in real values. Never commit `.env.production` —
# production values live in GitLab CI variables (see .gitlab-ci.yml header).

# Backend service URLs (used by src/app/api/proxy + src/config/api.ts)
NEXT_PUBLIC_AUTH_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_UTILITIES_API_BASE_URL=

# App config
NEXT_PUBLIC_API_VERSION=v2
NEXT_PUBLIC_DEFAULT_APP=eboss
NEXT_PUBLIC_DEFAULT_USER_TYPE=staff
NEXT_PUBLIC_APP_NAME=Admin Dashboard

# AI Chat (Anthropic Claude) — server-side only, never exposed to browser.
# In prod this comes from AWS Secrets Manager via the ECS task def, not
# from --build-arg.
ANTHROPIC_API_KEY=
