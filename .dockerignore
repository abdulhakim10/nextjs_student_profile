# Dependencies and build output
node_modules
.next
out
build
coverage

# Env files — none ship into the build context.
# NEXT_PUBLIC_* values are passed as --build-arg from GitLab CI variables;
# the Dockerfile's `ARG` + `ENV` lines forward them into `next build`.
# Server-side secrets (ANTHROPIC_API_KEY, EMAIL_API_KEY) come from AWS
# Secrets Manager via the ECS task def at runtime.
.env
.env.*

